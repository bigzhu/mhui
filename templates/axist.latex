\documentclass[$if(fontsize)$$fontsize$,$endif$]{article}
\usepackage{geometry}
\geometry{$if(geometry)$$geometry$$else$margin=2.2cm$endif$}
\usepackage[table]{xcolor}
\definecolor{axist}{HTML}{$if(color)$$color$$else$1F4B99$endif$}
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=$if(linkcolor)$$linkcolor$$else$axist$endif$,
  urlcolor=$if(linkcolor)$$linkcolor$$else$axist$endif$,
  citecolor=$if(linkcolor)$$linkcolor$$else$axist$endif$
}
\usepackage{titlesec}
\titleformat{\section}{\Large\bfseries}{\thesection}{0.8em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.2em}{0.6em}
\titlespacing*{\subsection}{0pt}{1em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.3em}
\usepackage{setspace}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
$if(linestretch)$
\setstretch{$linestretch$}
$endif$
\usepackage{fontspec}
\usepackage{xeCJK}
\setmainfont{$if(mainfont)$$mainfont$$else$Latin Modern Roman$endif$}
\setsansfont{$if(sansfont)$$sansfont$$else$Latin Modern Sans$endif$}
\setmonofont{$if(monofont)$$monofont$$else$Latin Modern Mono$endif$}
\setCJKmainfont{$if(CJKmainfont)$$CJKmainfont$$else$FandolSong-Regular$endif$}
\setCJKsansfont{$if(CJKsansfont)$$CJKsansfont$$else$FandolHei-Regular$endif$}
\newfontfamily\emojifont{Apple Color Emoji}
\renewcommand\CJKfamilydefault{\CJKrmdefault}
\usepackage{newunicodechar}
\newunicodechar{⭐}{{\emojifont⭐}}
\usepackage{longtable,booktabs}
\usepackage{array,colortbl,etoolbox}
\arrayrulecolor{gray!60}
\setlength{\arrayrulewidth}{0.5pt}
\renewcommand{\arraystretch}{1.15}
\newcommand{\axistrowcolors}{\rowcolors{2}{gray!6}{white}}
\newcommand{\axisthead}{\rowcolor{gray!12}}
\AtBeginEnvironment{longtable}{\axistrowcolors\arrayrulecolor{gray!60}}
\AtBeginEnvironment{tabular}{\axistrowcolors\arrayrulecolor{gray!60}}
\usepackage{enumitem}
\setlist[itemize]{leftmargin=1.4em,itemsep=0.35em,topsep=0.4em}
\setlist[enumerate]{leftmargin=1.5em,itemsep=0.35em,topsep=0.4em}
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\lhead{\textbf{$if(title)$$title$$endif$}}
\rhead{\small\thepage}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{gray!60}\leaders\hrule height \headrulewidth\hfill}}

$if(title)$
\title{\textbf{$title$}}
$endif$
$if(author)$
\author{$for(author)$$author$$sep$ \\ $endfor$}
$endif$
$if(date)$
\date{$date$}
$else$
\date{}
$endif$

\begin{document}
$if(title)$
\maketitle
$endif$
$if(toc)$
{
\hypersetup{linkcolor=black}
\tableofcontents
}
$endif$

$body$

\end{document}
